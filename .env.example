# ============================================================
# FuelLink AI — Environment Configuration Template
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file to version control.
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# --- Security ---
# Generate with: openssl rand -hex 64
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12
# Comma-separated list of allowed refresh token versions per user (advanced)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://fuellink:fuellink@localhost:5432/fuellink?schema=public

# --- Redis (cache / queues / sessions) ---
REDIS_URL=redis://localhost:6379

# --- AI Provider Abstraction ---
# Supported providers: mock | openai | anthropic | azure-openai
AI_PROVIDER=mock
AI_MODEL=gpt-4o-mini
AI_API_KEY=
AI_BASE_URL=
AI_MAX_TOKENS=2048
AI_TEMPERATURE=0.3
AI_TIMEOUT_MS=30000

# --- Object Storage (S3-compatible) ---
STORAGE_ENDPOINT=
STORAGE_BUCKET=fuellink
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=

# --- Email / Notifications ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FuelLink AI <no-reply@fuellink.ai>

# --- Observability ---
LOG_LEVEL=info
SENTRY_DSN=