// ============================================================
// FuelLink AI — Data Architecture
// Modular monolith schema with clear domain boundaries.
// Multi-tenant, multi-company, multi-currency, multi-language.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// IDENTITY & ORGANISATION DOMAIN
// ============================================================

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  industry  String?
  country   String?
  timezone  String   @default("UTC")
  locale    String   @default("en")
  currency  String   @default("USD")
  settings  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  organisations Organisation[]
  featureFlags FeatureFlag[]
}

model User {
  id            String    @id @default(cuid())
  tenantId      String
  email         String
  emailVerified Boolean   @default(false)
  passwordHash  String?
  firstName     String?
  lastName      String?
  phone         String?
  avatarUrl     String?
  status        UserStatus @default(ACTIVE)
  lastLoginAt   DateTime?
  mfaEnabled    Boolean   @default(false)
  mfaSecret     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships   Membership[]
  sessions      Session[]
  auditLogs     AuditLog[]
  aiUsage       AiUsage[]
  refreshTokens RefreshToken[]

  @@unique([tenantId, email])
  @@index([tenantId])
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
}

model Organisation {
  id          String   @id @default(cuid())
  tenantId    String
  parentId    String?
  name        String
  legalName   String?
  type        OrganisationType @default(COMPANY)
  industry    String?
  country     String?
  currency    String   @default("USD")
  taxId       String?
  regNumber   String?
  verified    Boolean  @default(false)
  trustScore  Int      @default(0)
  settings    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent      Organisation? @relation("OrgHierarchy", fields: [parentId], references: [id])
  children    Organisation[] @relation("OrgHierarchy")
  memberships Membership[]
  addresses   Address[]
  documents   Document[]
  suppliers   Supplier[]
  buyers      Buyer[]
  products    Product[]
  purchaseOrders PurchaseOrder[]
  contracts   Contract[]
  rfqs        Rfq[]
  quotes      Quote[]
  invoices    Invoice[]
  wallets     Wallet[]
  shipments   Shipment[]
  warehouses  Warehouse[]
  leads       Lead[]
  deals       Deal[]
  campaigns   Campaign[]

  @@index([tenantId])
}

enum OrganisationType {
  COMPANY
  GOVERNMENT
  NGO
  BUYER
  SUPPLIER
  MANUFACTURER
  DISTRIBUTOR
  LOGISTICS
  WAREHOUSE
  BANK
  INSURANCE
  INSPECTION
  CUSTOMS
  PORT
  FREIGHT_FORWARDER
  TECHNOLOGY_PARTNER
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organisationId String
  role           Role     @default(MEMBER)
  department     String?
  jobTitle       String?
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([userId, organisationId])
  @@index([organisationId])
}

enum Role {
  OWNER
  ADMIN
  PROCUREMENT_MANAGER
  FINANCE_MANAGER
  LOGISTICS_MANAGER
  WAREHOUSE_MANAGER
  SALES_MANAGER
  COMPLIANCE_OFFICER
  ANALYST
  MEMBER
  VIEWER
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  tokenHash    String   @unique
  ipAddress    String?
  userAgent    String?
  deviceName   String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model FeatureFlag {
  id        String   @id @default(cuid())
  tenantId  String
  key       String
  enabled   Boolean  @default(false)
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
}

// ============================================================
// COMMERCE / PROCUREMENT DOMAIN
// ============================================================

model Supplier {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  slug           String   @unique
  description    String?
  category       String?
  country        String?
  rating         Float    @default(0)
  verified       Boolean  @default(false)
  kybStatus      KybStatus @default(PENDING)
  riskScore      Int      @default(0)
  trustScore     Int      @default(0)
  certifications String[]
  capabilities   String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  products       Product[]
  quotes         Quote[]
  contracts      Contract[]
  scorecards     SupplierScorecard[]

  @@index([organisationId])
  @@index([category])
  @@index([country])
}

enum KybStatus {
  PENDING
  IN_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
}

model SupplierScorecard {
  id           String   @id @default(cuid())
  supplierId   String
  period       String
  onTimeRate   Float    @default(0)
  qualityRate  Float    @default(0)
  costRate     Float    @default(0)
  responseRate Float    @default(0)
  overallScore Float    @default(0)
  createdAt    DateTime @default(now())

  supplier     Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
}

model Buyer {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  category       String?
  country        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  rfqs           Rfq[]

  @@index([organisationId])
}

model Product {
  id             String   @id @default(cuid())
  organisationId String
  supplierId     String?
  name           String
  sku            String?
  description    String?
  category       String?
  unit           String?
  price          Decimal? @db.Decimal(18, 4)
  currency       String   @default("USD")
  stock          Int      @default(0)
  minStock       Int      @default(0)
  attributes     Json?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  supplier       Supplier? @relation(fields: [supplierId], references: [id])
  rfqLines       RfqLine[]
  quoteLines     QuoteLine[]
  poLines        PurchaseOrderLine[]
  inventoryItems InventoryItem[]

  @@index([organisationId])
  @@index([category])
}

model Rfq {
  id             String   @id @default(cuid())
  organisationId String
  buyerId        String?
  title          String
  description    String?
  status         RfqStatus @default(DRAFT)
  currency       String   @default("USD")
  dueDate        DateTime?
  publishedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  buyer          Buyer?   @relation(fields: [buyerId], references: [id])
  lines          RfqLine[]
  quotes         Quote[]

  @@index([organisationId])
  @@index([status])
}

enum RfqStatus {
  DRAFT
  PUBLISHED
  CLOSED
  AWARDED
  CANCELLED
}

model RfqLine {
  id        String   @id @default(cuid())
  rfqId     String
  productId String?
  description String
  quantity  Int
  unit      String?
  targetPrice Decimal? @db.Decimal(18, 4)
  createdAt DateTime @default(now())

  rfq       Rfq      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id])

  @@index([rfqId])
}

model Quote {
  id             String   @id @default(cuid())
  rfqId          String
  supplierId     String
  organisationId String
  status         QuoteStatus @default(SUBMITTED)
  currency       String   @default("USD")
  totalAmount    Decimal  @db.Decimal(18, 4)
  deliveryDays   Int?
  validUntil     DateTime?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  rfq            Rfq      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplier       Supplier @relation(fields: [supplierId], references: [id])
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  lines          QuoteLine[]
  purchaseOrders PurchaseOrder[]

  @@index([rfqId])
  @@index([supplierId])
}

enum QuoteStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  WITHDRAWN
}

model QuoteLine {
  id        String   @id @default(cuid())
  quoteId   String
  productId String?
  description String
  quantity  Int
  unitPrice Decimal  @db.Decimal(18, 4)
  total     Decimal  @db.Decimal(18, 4)
  createdAt DateTime @default(now())

  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id])

  @@index([quoteId])
}

model PurchaseOrder {
  id             String   @id @default(cuid())
  organisationId String
  supplierId     String?
  quoteId        String?
  poNumber       String   @unique
  status         PoStatus @default(DRAFT)
  currency       String   @default("USD")
  totalAmount    Decimal  @db.Decimal(18, 4)
  approvalStatus ApprovalStatus @default(PENDING)
  approvedById   String?
  approvedAt     DateTime?
  expectedDelivery DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  supplier       Supplier? @relation(fields: [supplierId], references: [id])
  quote          Quote?   @relation(fields: [quoteId], references: [id])
  lines          PurchaseOrderLine[]
  invoices       Invoice[]

  @@index([organisationId])
  @@index([status])
}

enum PoStatus {
  DRAFT
  SUBMITTED
  CONFIRMED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  REQUIRES_CHANGES
}

model PurchaseOrderLine {
  id          String   @id @default(cuid())
  poId        String
  productId   String?
  description String
  quantity    Int
  unitPrice   Decimal  @db.Decimal(18, 4)
  total       Decimal  @db.Decimal(18, 4)
  receivedQty Int      @default(0)
  createdAt   DateTime @default(now())

  po          PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])

  @@index([poId])
}

model Contract {
  id             String   @id @default(cuid())
  organisationId String
  supplierId     String?
  title          String
  status         ContractStatus @default(DRAFT)
  startDate      DateTime?
  endDate        DateTime?
  value          Decimal? @db.Decimal(18, 4)
  currency       String   @default("USD")
  terms          String?
  signedAt       DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  supplier       Supplier? @relation(fields: [supplierId], references: [id])

  @@index([organisationId])
  @@index([status])
}

enum ContractStatus {
  DRAFT
  NEGOTIATION
  ACTIVE
  COMPLETED
  TERMINATED
  EXPIRED
}

model Invoice {
  id             String   @id @default(cuid())
  organisationId String
  purchaseOrderId String?
  invoiceNumber  String   @unique
  status         InvoiceStatus @default(DRAFT)
  currency       String   @default("USD")
  amount         Decimal  @db.Decimal(18, 4)
  taxAmount      Decimal  @default(0) @db.Decimal(18, 4)
  dueDate        DateTime?
  paidAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  purchaseOrder  PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  @@index([organisationId])
  @@index([status])
}

enum InvoiceStatus {
  DRAFT
  SENT
  OVERDUE
  PARTIALLY_PAID
  PAID
  CANCELLED
}

// ============================================================
// INVENTORY & WAREHOUSE DOMAIN
// ============================================================

model Warehouse {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  code           String
  address        String?
  city           String?
  country        String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  inventoryItems InventoryItem[]

  @@index([organisationId])
}

model InventoryItem {
  id          String   @id @default(cuid())
  warehouseId String
  productId   String
  quantity    Int      @default(0)
  reservedQty Int      @default(0)
  location    String?
  batchCode   String?
  expiryDate  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([warehouseId, productId, batchCode])
  @@index([productId])
}

// ============================================================
// LOGISTICS DOMAIN
// ============================================================

model Shipment {
  id             String   @id @default(cuid())
  organisationId String
  trackingNumber String   @unique
  status         ShipmentStatus @default(CREATED)
  origin         String?
  destination    String?
  carrier        String?
  mode           String?
  eta            DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  events         ShipmentEvent[]

  @@index([organisationId])
  @@index([status])
}

enum ShipmentStatus {
  CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  EXCEPTION
  CANCELLED
}

model ShipmentEvent {
  id         String   @id @default(cuid())
  shipmentId String
  status     ShipmentStatus
  location   String?
  note       String?
  createdAt  DateTime @default(now())

  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
}

// ============================================================
// FINANCE DOMAIN
// ============================================================

model Wallet {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  currency       String   @default("USD")
  balance        Decimal  @default(0) @db.Decimal(18, 4)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  transactions   WalletTransaction[]

  @@index([organisationId])
}

model WalletTransaction {
  id        String   @id @default(cuid())
  walletId  String
  type      TransactionType
  amount    Decimal  @db.Decimal(18, 4)
  currency  String   @default("USD")
  reference String?
  status    TransactionStatus @default(PENDING)
  createdAt DateTime @default(now())

  wallet    Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  PAYMENT
  REFUND
  ESCROW_HOLD
  ESCROW_RELEASE
  FEE
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

// ============================================================
// CRM DOMAIN
// ============================================================

model Lead {
  id             String   @id @default(cuid())
  organisationId String
  companyName    String?
  contactName    String?
  email          String?
  phone          String?
  source         String?
  status         LeadStatus @default(NEW)
  score          Int      @default(0)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  deals          Deal[]

  @@index([organisationId])
  @@index([status])
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

model Deal {
  id             String   @id @default(cuid())
  organisationId String
  leadId         String?
  name           String
  stage          DealStage @default(LEAD)
  amount         Decimal? @db.Decimal(18, 4)
  currency       String   @default("USD")
  probability    Int      @default(10)
  expectedClose  DateTime?
  ownerId        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  lead           Lead?    @relation(fields: [leadId], references: [id])

  @@index([organisationId])
  @@index([stage])
}

enum DealStage {
  LEAD
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

model Campaign {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  type           String?
  status         CampaignStatus @default(DRAFT)
  subject        String?
  content        String?
  scheduledAt    DateTime?
  sentAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  PAUSED
  CANCELLED
}

// ============================================================
// AI PLATFORM DOMAIN
// ============================================================

model AiUsage {
  id          String   @id @default(cuid())
  userId      String
  tenantId    String
  agent       String
  provider    String
  model       String
  promptTokens Int     @default(0)
  completionTokens Int @default(0)
  totalTokens Int      @default(0)
  costUsd     Decimal  @default(0) @db.Decimal(18, 6)
  latencyMs   Int      @default(0)
  status      String   @default("success")
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
  @@index([createdAt])
}

model AiAuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  agent     String
  action    String
  input     Json?
  output    Json?
  approved  Boolean  @default(false)
  approvedById String?
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([createdAt])
}

// ============================================================
// SHARED / CROSS-CUTTING DOMAIN
// ============================================================

model Address {
  id             String   @id @default(cuid())
  organisationId String
  type           String?
  line1          String
  line2          String?
  city           String?
  state          String?
  postalCode     String?
  country        String?
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())

  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
}

model Document {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  type           String?
  url            String
  mimeType       String?
  sizeBytes      Int?
  verified       Boolean  @default(false)
  createdAt      DateTime @default(now())

  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}